# Copy to .env and replace both values with independently generated secrets.
# NXPCTL_ADMIN_TOKEN must contain at least 32 characters.
NXPCTL_ADMIN_TOKEN=replace-with-a-random-token-of-at-least-48-bytes
# Exactly 64 hexadecimal characters (32 random bytes). Back this up securely.
NXPCTL_PARENT_AUTH_KEY=replace-with-64-hexadecimal-characters
